ORT_DYLIB_PATH="./onnxruntime/lib/onnxruntime.dll"


# Optional native ONNX Runtime library path, either absolute or relative to
# the directory that contains config.example.json.
# WINDOWS (example):
# ORT_DYLIB_PATH=./onnxruntime/lib/onnxruntime.dll
# LINUX (example):
# ORT_DYLIB_PATH=./onnxruntime/lib/libonnxruntime.so
# MACOS (example):
# ORT_DYLIB_PATH=./onnxruntime/lib/libonnxruntime.dylib

